# Copy to engine.env before building the installer (never commit real secrets).
# sync_engine.ps1 copies cybersentinel-backend/.env when present.

HOST=127.0.0.1
PORT=8000
DEBUG=false

# Required — Supabase + JWT (must match across all desktop installs)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

DEFAULT_ADMIN_EMAIL=admin@cybersentinel.local
DEFAULT_ADMIN_PASSWORD=change-me-after-first-login
ALLOW_PUBLIC_SIGNUP=true
USE_API_KEY_AUTH=false

CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Password reset email (required for forgot-password to work)
# Use Resend OR SMTP — same as cybersentinel-backend/.env.example
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CyberSentinel
SMTP_USE_TLS=true
# Desktop app deep link (Windows installer registers cybersentinel:// protocol).
# Flutter web alternative: https://your-domain.com/reset-password
FRONTEND_RESET_PASSWORD_URL=cybersentinel://reset-password

# ---------------------------------------------------------------------------
# Optional threat-intel APIs (app works without these; features degrade gracefully)
# ---------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_BASE_URL=http://ip-api.com/json

# ---------------------------------------------------------------------------
# Optional Security Copilot LLM (leave empty for rule-based answers only)
# ---------------------------------------------------------------------------
COPILOT_LLM_API_KEY=
COPILOT_LLM_BASE_URL=
COPILOT_LLM_MODEL=

# Model dirs (set automatically by engine_main when frozen)
# SUPERVISED_MODEL_DIR=./supervised_learning/models
# UNSUPERVISED_MODEL_DIR=./unsupervised_learning/models
