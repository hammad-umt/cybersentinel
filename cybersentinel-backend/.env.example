APP_NAME=CyberSentinel
APP_VERSION=1.0.0
DEBUG=false
DEFAULT_ADMIN_EMAIL=admin@cybersentinel.local
DEFAULT_ADMIN_PASSWORD=admin123
ALLOW_PUBLIC_SIGNUP=true
USE_API_KEY_AUTH=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Legacy API key (only used when USE_API_KEY_AUTH=true)
# API_KEY=sk_cybersentinel_prod_v1_8f4e2b9c1a7d5e3f
CYBERSENTINEL_MASTER_KEY=
HOST=0.0.0.0
PORT=8000

# Comma-separated origins for Flutter web / frontend clients.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# Cloud Supabase (primary) — Connection Pooler Session mode (port 5432) for IPv4.
# Keep concurrent DB usage low: session mode allows ~15 pooled connections total.
# For heavy local dev, use Transaction mode on port 6543 instead (see commented line below).
# Supabase Dashboard → Database → Connection string → Connection pooling → Session mode
# Username format: postgres.YOUR_PROJECT_REF  |  URL-encode special chars in password (@ → %40)
# Driver must be postgresql+asyncpg:// (config auto-converts postgresql:// if needed)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Optional: Transaction pooler (port 6543) — better for parallel API load during development.
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Local SQLite fallback removed — Supabase PostgreSQL only.
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@...pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
# JWT Authentication (Sprint 3)
# Generate secret: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Email — password reset (choose ONE provider)
#
# Option A — Resend (recommended for production): https://resend.com
#   1. Sign up, verify your domain (or use onboarding@resend.dev for testing)
#   2. Create an API key
#   3. Set RESEND_API_KEY and SMTP_FROM_EMAIL to your verified sender
#
# Option B — Gmail SMTP (fine for FYP / small deployments)
#   1. Enable 2FA on Google account
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Fill SMTP_* below
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CyberSentinel
SMTP_USE_TLS=true
# Desktop deep link (after Windows install) or Flutter web URL for browser reset.
FRONTEND_RESET_PASSWORD_URL=https://cybersentinel.dev/reset-password

# These paths match the current repository layout where training folders are
# siblings of cybersentinel-backend.
SUPERVISED_MODEL_DIR=../supervised_learning/models
UNSUPERVISED_MODEL_DIR=../unsupervised_learning/models

MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FLOWS=10000
MAX_PCAP_PACKETS=5000
DASHBOARD_TREND_DAYS=7
COPILOT_LLM_API_KEY=
COPILOT_LLM_BASE_URL=
COPILOT_LLM_MODEL=
RATE_LIMIT_PER_MINUTE=0
RESPONSE_ACTION_EXECUTION_ENABLED=false

VIRUSTOTAL_API_KEY=your_virus_total_api_key
ABUSEIPDB_API_KEY=your_abuse_ip_db_api_key
GEOIP_BASE_URL=http://ip-api.com/json

ENSEMBLE_WEIGHT_PACKET=0.30
ENSEMBLE_WEIGHT_ANOMALY=0.35
ENSEMBLE_WEIGHT_VIRUSTOTAL=0.20
ENSEMBLE_WEIGHT_IP_REPUTATION=0.15
