APP_NAME=CyberSentinel
APP_VERSION=1.0.0
DEBUG=false
ADMIN_API_KEY=
HOST=127.0.0.1
PORT=8000

# Comma-separated origins for Flutter web / frontend clients.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# SQLite works for demos/FYP. Use PostgreSQL for a deployed multi-user server.
DATABASE_URL=sqlite+aiosqlite:///./cybersentinel.db

# These paths match the current repository layout where training folders are
# siblings of cybersentinel-backend.
SUPERVISED_MODEL_DIR=../supervised_learning/models
UNSUPERVISED_MODEL_DIR=../unsupervised_learning/models

MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FLOWS=10000
RATE_LIMIT_PER_MINUTE=60

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_BASE_URL=http://ip-api.com/json
