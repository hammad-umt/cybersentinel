APP_NAME=CyberSentinel
APP_VERSION=1.0.0
DEBUG=false
ADMIN_API_KEY=your-strong-secret-key
ANALYST_API_KEY=your-analyst-readonly-key
CYBERSENTINEL_MASTER_KEY=
HOST=0.0.0.0
PORT=8000

# Comma-separated origins for Flutter web / frontend clients.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# SQLite works for demos/FYP. Use PostgreSQL for a deployed multi-user server.
DATABASE_URL=sqlite+aiosqlite:///./cybersentinel.db

# These paths match the current repository layout where training folders are
# siblings of cybersentinel-backend.
SUPERVISED_MODEL_DIR=../supervised_learning/models
UNSUPERVISED_MODEL_DIR=../unsupervised_learning/models

MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FLOWS=10000
MAX_PCAP_PACKETS=5000
DASHBOARD_TREND_DAYS=7
COPILOT_LLM_API_KEY=
COPILOT_LLM_BASE_URL=
COPILOT_LLM_MODEL=
RATE_LIMIT_PER_MINUTE=60
RESPONSE_ACTION_EXECUTION_ENABLED=false

VIRUSTOTAL_API_KEY=ac542260c8c71fb48822cb4732781ce814c38fe319daad6ebc91c293367ae675
ABUSEIPDB_API_KEY=ef9a7d62bbce77407903317a6c2fcad2300ad82970cfa6f619f6fa31b2f2cf024228ba7fa0180baa
GEOIP_BASE_URL=http://ip-api.com/json

ENSEMBLE_WEIGHT_PACKET=0.30
ENSEMBLE_WEIGHT_ANOMALY=0.35
ENSEMBLE_WEIGHT_VIRUSTOTAL=0.20
ENSEMBLE_WEIGHT_IP_REPUTATION=0.15
